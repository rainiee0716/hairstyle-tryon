# 本地开发变量（cp 为 .env.local；部署到 Cloudflare 时这些用 wrangler secret / vars 配置）
# 渲染供应商三选一（不配置则进入 mock 模式，返回原图，流程可跑通）
# 方案A：Google Gemini（AI Studio 免费层可用）
# IMAGE_PROVIDER=gemini
# GEMINI_API_KEY=你的key

# 方案B：火山方舟 SeedEdit（已有方舟账号则推荐）
# IMAGE_PROVIDER=ark
# ARK_API_KEY=你的方舟key
# ARK_IMAGE_MODEL=doubao-seededit-3-0-i2i

# 会话签名密钥（openssl rand -hex 32）
# AUTH_SECRET=

# Google 登录（OAuth 客户端，回调地址见 DEPLOY.md）
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# 支付：Stripe（sk_test_ 开头的测试 key）+ PayPal（sandbox）
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_ENV=sandbox

# 站点域名（部署后设置）
# NEXT_PUBLIC_SITE_URL=https://hairstyle-tryon.com
